<Window x:Class="Rayvia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rayvia"
        Icon="Assets/rayvia.ico"
        Width="1240"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#101318"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/rayvia.ico" Width="38" Height="38"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rayvia" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Proxy client"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButton}" Content="Главная" Click="Home_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Подписки" Click="Subscriptions_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Серверы" Click="Servers_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Маршрутизация" Click="Routing_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Соединения" Click="Connections_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Журнал" Click="Logs_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Настройки" Click="Settings_Click"/>
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           Grid.Row="3"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="12,0,0,4"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Background="#15233A"
                    BorderBrush="#274A7D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,10"
                    Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,7"
                            Content="Установить"
                            Click="InstallUpdate_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle"
                                   FontWeight="SemiBold"
                                   Text="Доступно обновление"/>
                        <TextBlock Text="Установщик скачан и проверен."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <TextBlock x:Name="PageTitle"
                           Text="Главная"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitle"
                           Text="Подключение и состояние"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2">

                <!-- HOME -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <Ellipse x:Name="StatusDot"
                                             Width="9"
                                             Height="9"
                                             Fill="{StaticResource MutedBrush}"
                                             Margin="0,4,9,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="StatusText"
                                                   Text="Не подключено"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ActiveServerText"
                                                   Text="Сервер не выбран"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Режим подключения"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,7"/>
                                <ComboBox x:Name="ConnectionModeCombo"
                                          Height="42"
                                          SelectionChanged="ConnectionModeCombo_SelectionChanged"
                                          Margin="0,0,0,16">
                                    <ComboBoxItem Content="System Proxy" Tag="SystemProxy"/>
                                    <ComboBoxItem Content="TUN — весь трафик Windows" Tag="Tun"/>
                                </ComboBox>

                                <TextBlock Text="Группа"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,7"/>
                                <ComboBox x:Name="HomeGroupCombo"
                                          Height="42"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="HomeGroupCombo_SelectionChanged"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="Сервер"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,7"/>
                                <ComboBox x:Name="ServerCombo"
                                          Height="42"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="ServerCombo_SelectionChanged"
                                          Margin="0,0,0,14"/>

                                <CheckBox x:Name="AutoSelectCheck"
                                          Content="Выбирать сервер с минимальной задержкой"
                                          Checked="AutoSelectCheck_Changed"
                                          Unchecked="AutoSelectCheck_Changed"
                                          Margin="0,0,0,22"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ConnectButton"
                                            Height="46"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Подключить"
                                            Click="Connect_Click"/>

                                    <Button Grid.Column="2"
                                            x:Name="PingHomeButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Проверить задержку"
                                            Click="PingAll_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Состояние"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Xray core" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomeCoreText"
                                                   Text="Не запущен"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Режим" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomeModeText"
                                                   Text="System Proxy"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="System Proxy" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomeProxyText"
                                                   Text="Выключен"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Локальный HTTP" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomePortText"
                                                   Text="127.0.0.1:10809"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="TUN"
                                               FontWeight="SemiBold"
                                               FontSize="15"/>
                                    <TextBlock Text="TUN перехватывает системный трафик через Wintun. При первом запуске Windows запросит права администратора."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               LineHeight="19"
                                               Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- SUBSCRIPTIONS -->
                <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SubscriptionUrlText"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     ToolTip="URL подписки или ссылка сервера"
                                     KeyDown="SubscriptionUrlText_KeyDown"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Добавить"
                                    Click="AddSubscription_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SubscriptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Url}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,5,20,0"/>
                                                <TextBlock Text="{Binding UpdatedDisplay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,4,20,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Padding="12,7"
                                                        Content="Обновить"
                                                        Tag="{Binding Id}"
                                                        Click="RefreshSubscription_Click"
                                                        Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Padding="12,7"
                                                        Content="Удалить"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteSubscription_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SERVERS -->
                <Grid x:Name="ServersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PingAllButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Проверить все"
                                    Click="PingAll_Click"/>

                            <TextBox x:Name="NewGroupText"
                                     Grid.Column="2"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Название группы"/>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Создать группу"
                                    Click="CreateGroup_Click"/>

                            <CheckBox x:Name="AutoSelectServersCheck"
                                      Grid.Column="6"
                                      VerticalAlignment="Center"
                                      Content="Автовыбор"
                                      Checked="AutoSelectCheck_Changed"
                                      Unchecked="AutoSelectCheck_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ServerGroupCombo"
                                      Height="40"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="ServerGroupCombo_SelectionChanged"/>

                            <ComboBox x:Name="GroupMemberServerCombo"
                                      Grid.Column="2"
                                      Height="40"
                                      DisplayMemberPath="Display"/>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Добавить в группу"
                                    Click="AddServerToGroup_Click"/>

                            <Button Grid.Column="6"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Удалить группу"
                                    Click="DeleteGroup_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ServersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="14"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Endpoint}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LatencyDisplay}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,6"
                                                        Content="Выбрать"
                                                        Tag="{Binding Id}"
                                                        Click="SelectServer_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="GroupMembersTitle"
                                           Text="Состав группы"
                                           FontWeight="SemiBold"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="GroupMembersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Endpoint}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="8,4"
                                                            Content="Убрать"
                                                            Tag="{Binding Id}"
                                                            Click="RemoveServerFromGroup_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ROUTING -->
                <ScrollViewer x:Name="RoutingPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Режим" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <RadioButton x:Name="SmartRadio"
                                             Content="Россия и локальные сети напрямую, остальное через прокси"
                                             GroupName="RoutingMode"
                                             Tag="Smart"
                                             Checked="RoutingMode_Checked"
                                             Margin="0,0,0,10"/>
                                <RadioButton x:Name="ProxyAllRadio"
                                             Content="Всё через прокси"
                                             GroupName="RoutingMode"
                                             Tag="ProxyAll"
                                             Checked="RoutingMode_Checked"
                                             Margin="0,0,0,10"/>
                                <RadioButton x:Name="DirectAllRadio"
                                             Content="Всё напрямую"
                                             GroupName="RoutingMode"
                                             Tag="DirectAll"
                                             Checked="RoutingMode_Checked"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RulePatternText"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         ToolTip="example.com, 1.2.3.4/24, geosite:..."/>
                                <ComboBox x:Name="RuleActionCombo"
                                          Grid.Column="2"
                                          Height="40"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Через прокси" Tag="proxy"/>
                                    <ComboBoxItem Content="Напрямую" Tag="direct"/>
                                    <ComboBoxItem Content="Блокировать" Tag="block"/>
                                </ComboBox>
                                <Button Grid.Column="4"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Добавить правило"
                                        Click="AddRule_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Routing Inspector"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <TextBlock Text="Показывает, какое правило должно сработать для домена или IP."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InspectorTargetText"
                                             Height="40"
                                             VerticalContentAlignment="Center"
                                             ToolTip="ozon.ru или 8.8.8.8"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Проверить"
                                            Click="InspectRoute_Click"/>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Маршрут" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="InspectorRouteText" Grid.Column="1" Text="—" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Text="Правило" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="InspectorRuleText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Text="DNS" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="InspectorResolvedText"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Text="—"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Text="Комментарий" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="InspectorNoteText"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Text="—"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Pattern}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ActionDisplay}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    Content="Удалить"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteRule_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONNECTIONS -->
                <Grid x:Name="ConnectionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="Последние соединения Xray"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                Content="Очистить"
                                Click="ClearConnections_Click"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Destination}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RouteDisplay}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Source}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- LOGS -->
                <Border x:Name="LogsPage"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <ListBox x:Name="LogList"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"/>
                </Border>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Обновления"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <CheckBox x:Name="AutoUpdateCheck"
                                          Content="Проверять обновления при запуске"
                                          Checked="AutoUpdateCheck_Changed"
                                          Unchecked="AutoUpdateCheck_Changed"
                                          Margin="0,14,0,12"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Content="Проверить сейчас"
                                        Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Локальные порты"
                                           FontWeight="SemiBold"
                                           FontSize="15"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="SOCKS"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="SocksPortText"
                                             Grid.Column="1"
                                             Height="38"
                                             VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="HTTP"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="HttpPortText"
                                             Grid.Column="4"
                                             Height="38"
                                             VerticalContentAlignment="Center"/>

                                    <Button Grid.Column="6"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Сохранить"
                                            Click="SavePorts_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>
