<Window x:Class="Rayvia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rayvia"
        Icon="Assets/rayvia.ico"
        Width="1000"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,16,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="#162236">
                        <Image Source="Assets/rayvia.ico"
                               Width="28"
                               Height="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Rayvia"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Proxy client"
                                   Foreground="{StaticResource SidebarMutedBrush}"
                                   FontSize="10"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="NavHomeButton"
                            Style="{StaticResource NavButton}"
                            Content="Главная"
                            Click="Home_Click"/>
                    <Button x:Name="NavSubscriptionsButton"
                            Style="{StaticResource NavButton}"
                            Content="Подписки"
                            Click="Subscriptions_Click"/>
                    <Button x:Name="NavServersButton"
                            Style="{StaticResource NavButton}"
                            Content="Серверы"
                            Click="Servers_Click"/>
                    <Button x:Name="NavRoutingButton"
                            Style="{StaticResource NavButton}"
                            Content="Маршрутизация"
                            Click="Routing_Click"/>
                    <Button x:Name="NavConnectionsButton"
                            Style="{StaticResource NavButton}"
                            Content="Соединения"
                            Click="Connections_Click"/>
                    <Button x:Name="NavLogsButton"
                            Style="{StaticResource NavButton}"
                            Content="Журнал"
                            Click="Logs_Click"/>
                    <Button x:Name="NavSettingsButton"
                            Style="{StaticResource NavButton}"
                            Content="Настройки"
                            Click="Settings_Click"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="#161F2E"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Rayvia"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText"
                                   Foreground="{StaticResource SidebarMutedBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1"
              Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9"
                    Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6"
                            MinHeight="32"
                            Content="Установить"
                            Click="InstallUpdate_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle"
                                   Text="Доступно обновление"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="Установщик скачан и проверен."
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Text="Главная"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock x:Name="PageSubtitle"
                               Text="Подключение и состояние"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">

                <!-- HOME -->
                <ScrollViewer x:Name="HomePage"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="760"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="272"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="StatusDot"
                                             Width="9"
                                             Height="9"
                                             Fill="{StaticResource MutedBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,5,9,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="StatusText"
                                                   Text="Не подключено"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ActiveServerText"
                                                   Text="Сервер не выбран"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Режим подключения"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="ConnectionModeCombo"
                                          Height="38"
                                          SelectionChanged="ConnectionModeCombo_SelectionChanged"
                                          Margin="0,0,0,12">
                                    <ComboBoxItem Content="System Proxy" Tag="SystemProxy"/>
                                    <ComboBoxItem Content="TUN — весь трафик Windows" Tag="Tun"/>
                                </ComboBox>

                                <TextBlock Text="Группа"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="HomeGroupCombo"
                                          Height="38"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="HomeGroupCombo_SelectionChanged"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Сервер"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="ServerCombo"
                                          Height="38"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="ServerCombo_SelectionChanged"
                                          Margin="0,0,0,12"/>

                                <CheckBox x:Name="AutoSelectCheck"
                                          Content="Выбирать сервер с минимальной задержкой"
                                          Checked="AutoSelectCheck_Changed"
                                          Unchecked="AutoSelectCheck_Changed"
                                          Margin="0,0,0,17"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ConnectButton"
                                            Height="40"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Подключить"
                                            Click="Connect_Click"/>
                                    <Button Grid.Column="2"
                                            x:Name="PingHomeButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Проверить задержку"
                                            Click="PingAll_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Состояние"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0,0,0,13"/>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Xray core" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="HomeCoreText"
                                                   Text="Не запущен"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Режим" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="HomeModeText"
                                                   Text="System Proxy"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="System Proxy" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="HomeProxyText"
                                                   Text="Выключен"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="HTTP" Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="HomePortText"
                                                   Text="127.0.0.1:10809"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="TUN"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Перехватывает системный трафик через Wintun. Windows запросит права администратора."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionStyle}"
                                               LineHeight="18"
                                               Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- SUBSCRIPTIONS -->
                <Grid x:Name="SubscriptionsPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Width="690"
                            HorizontalAlignment="Left"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SubscriptionUrlText"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     ToolTip="URL подписки или ссылка сервера"
                                     KeyDown="SubscriptionUrlText_KeyDown"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="104"
                                    Content="Добавить"
                                    Click="AddSubscription_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SubscriptionsList"
                                      Width="690"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Url}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,16,0"/>
                                                <TextBlock Text="{Binding UpdatedDisplay}"
                                                           Foreground="#98A2B3"
                                                           FontSize="10"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Padding="10,5"
                                                        MinHeight="30"
                                                        Content="Обновить"
                                                        Tag="{Binding Id}"
                                                        Click="RefreshSubscription_Click"
                                                        Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Padding="10,5"
                                                        MinHeight="30"
                                                        Content="Удалить"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteSubscription_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- SERVERS -->
                <Grid x:Name="ServersPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PingAllButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Проверить все"
                                    Click="PingAll_Click"/>

                            <TextBox x:Name="NewGroupText"
                                     Grid.Column="2"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Название группы"/>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Создать группу"
                                    Click="CreateGroup_Click"/>

                            <CheckBox x:Name="AutoSelectServersCheck"
                                      Grid.Column="6"
                                      VerticalAlignment="Center"
                                      Content="Автовыбор"
                                      Checked="AutoSelectCheck_Changed"
                                      Unchecked="AutoSelectCheck_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ServerGroupCombo"
                                      Height="36"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="ServerGroupCombo_SelectionChanged"/>

                            <ComboBox x:Name="GroupMemberServerCombo"
                                      Grid.Column="2"
                                      Height="36"
                                      DisplayMemberPath="Display"/>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Добавить"
                                    Click="AddServerToGroup_Click"/>

                            <Button Grid.Column="6"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Удалить группу"
                                    Click="DeleteGroup_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ServersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="11"
                                                Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Endpoint}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               FontSize="10"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LatencyDisplay}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"/>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="9,4"
                                                        MinHeight="28"
                                                        Content="Выбрать"
                                                        Tag="{Binding Id}"
                                                        Click="SelectServer_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="GroupMembersTitle"
                                           Text="Состав группы"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="GroupMembersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"/>
                                                        <TextBlock Text="{Binding Endpoint}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   FontSize="10"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="8,3"
                                                            MinHeight="26"
                                                            Content="Убрать"
                                                            Tag="{Binding Id}"
                                                            Click="RemoveServerFromGroup_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ROUTING -->
                <ScrollViewer x:Name="RoutingPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="720"
                                HorizontalAlignment="Left">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Режим"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,11"/>
                                <RadioButton x:Name="SmartRadio"
                                             Content="Россия и локальные сети напрямую, остальное через прокси"
                                             GroupName="RoutingMode"
                                             Tag="Smart"
                                             Checked="RoutingMode_Checked"
                                             Margin="0,0,0,8"/>
                                <RadioButton x:Name="ProxyAllRadio"
                                             Content="Всё через прокси"
                                             GroupName="RoutingMode"
                                             Tag="ProxyAll"
                                             Checked="RoutingMode_Checked"
                                             Margin="0,0,0,8"/>
                                <RadioButton x:Name="DirectAllRadio"
                                             Content="Всё напрямую"
                                             GroupName="RoutingMode"
                                             Tag="DirectAll"
                                             Checked="RoutingMode_Checked"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RulePatternText"
                                         Height="36"
                                         VerticalContentAlignment="Center"
                                         ToolTip="example.com, 1.2.3.4/24, geosite:..."/>
                                <ComboBox x:Name="RuleActionCombo"
                                          Grid.Column="2"
                                          Height="36"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Через прокси" Tag="proxy"/>
                                    <ComboBoxItem Content="Напрямую" Tag="direct"/>
                                    <ComboBoxItem Content="Блокировать" Tag="block"/>
                                </ComboBox>
                                <Button Grid.Column="4"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Добавить"
                                        Click="AddRule_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Routing Inspector"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Показывает ожидаемое правило для домена или IP."
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,4,0,11"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InspectorTargetText"
                                             Height="36"
                                             VerticalContentAlignment="Center"
                                             ToolTip="ozon.ru или 8.8.8.8"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Проверить"
                                            Click="InspectRoute_Click"/>
                                </Grid>

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Маршрут" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InspectorRouteText" Grid.Column="1" Text="—" FontSize="12" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="1" Text="Правило" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InspectorRuleText" Grid.Row="1" Grid.Column="1" Text="—" FontSize="12" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="2" Text="DNS" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InspectorResolvedText"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Text="—"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="3" Text="Комментарий" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="InspectorNoteText"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Text="—"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="11"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Pattern}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ActionDisplay}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="9,4"
                                                    MinHeight="28"
                                                    Content="Удалить"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteRule_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONNECTIONS -->
                <Grid x:Name="ConnectionsPage"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="Последние соединения Xray"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5"
                                MinHeight="30"
                                Content="Очистить"
                                Click="ClearConnections_Click"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Destination}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RouteDisplay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Source}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- LOGS -->
                <Border x:Name="LogsPage"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <ListBox x:Name="LogList"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"/>
                </Border>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Width="640"
                                HorizontalAlignment="Left">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Обновления"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="AutoUpdateCheck"
                                          Content="Проверять обновления при запуске"
                                          Checked="AutoUpdateCheck_Changed"
                                          Unchecked="AutoUpdateCheck_Changed"
                                          Margin="0,12,0,10"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Padding="11,6"
                                        MinHeight="32"
                                        Content="Проверить сейчас"
                                        Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Локальные порты"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="SOCKS"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <TextBox x:Name="SocksPortText"
                                             Grid.Column="1"
                                             Height="36"
                                             VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="HTTP"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}"/>
                                    <TextBox x:Name="HttpPortText"
                                             Grid.Column="4"
                                             Height="36"
                                             VerticalContentAlignment="Center"/>

                                    <Button Grid.Column="6"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Сохранить"
                                            Click="SavePorts_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>
