<Window x:Class="Rayvia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rayvia"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101318" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="R" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rayvia" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Proxy client" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButton}" Content="Главная" Click="Home_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Подписки" Click="Subscriptions_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Маршрутизация" Click="Routing_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Журнал" Click="Logs_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Настройки" Click="Settings_Click"/>
                </StackPanel>

                <TextBlock x:Name="VersionText" Grid.Row="3" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,4"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Background="#15233A"
                    BorderBrush="#274A7D"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,10"
                    Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,7"
                            Content="Установить"
                            Click="InstallUpdate_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Text="Доступно обновление"/>
                        <TextBlock Text="Установщик уже скачан." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitle" Text="Подключение и состояние клиента" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,24">
                                    <StackPanel DockPanel.Dock="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" Margin="0,0,9,0"/>
                                            <TextBlock x:Name="StatusText" Text="Не подключено" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="System Proxy" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Сервер" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                                <ComboBox x:Name="ServerCombo"
                                          Height="42"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="ServerCombo_SelectionChanged"
                                          Margin="0,0,0,18"/>

                                <TextBlock Text="Маршрутизация" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                                <ComboBox x:Name="HomeRoutingCombo" Height="42" SelectionChanged="HomeRoutingCombo_SelectionChanged" Margin="0,0,0,26">
                                    <ComboBoxItem Content="Умная — Россия напрямую" Tag="Smart"/>
                                    <ComboBoxItem Content="Всё через прокси" Tag="ProxyAll"/>
                                    <ComboBoxItem Content="Всё напрямую" Tag="DirectAll"/>
                                </ComboBox>

                                <Button x:Name="ConnectButton"
                                        Height="46"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Подключить"
                                        Click="Connect_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Состояние" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Xray core" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomeCoreText" Text="Не запущен" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="System Proxy" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomeProxyText" Text="Выключен" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="HTTP" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="HomePortText" Text="127.0.0.1:10809" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Быстрый старт" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Добавьте URL подписки или ссылку сервера, выберите сервер и нажмите «Подключить»."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               LineHeight="19"
                                               Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SubscriptionUrlText"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     ToolTip="https://… или vless://…"
                                     KeyDown="SubscriptionUrlText_KeyDown"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Добавить"
                                    Click="AddSubscription_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SubscriptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,20,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Content="Обновить" Tag="{Binding Id}" Click="RefreshSubscription_Click" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Content="Удалить" Tag="{Binding Id}" Click="DeleteSubscription_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="RoutingPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Режим" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <RadioButton x:Name="SmartRadio" Content="Умная — российские IP и сайты напрямую, остальное через прокси" GroupName="RoutingMode" Tag="Smart" Checked="RoutingMode_Checked" Margin="0,0,0,10"/>
                            <RadioButton x:Name="ProxyAllRadio" Content="Всё через прокси" GroupName="RoutingMode" Tag="ProxyAll" Checked="RoutingMode_Checked" Margin="0,0,0,10"/>
                            <RadioButton x:Name="DirectAllRadio" Content="Всё напрямую" GroupName="RoutingMode" Tag="DirectAll" Checked="RoutingMode_Checked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RulePatternText" Height="40" VerticalContentAlignment="Center" ToolTip="example.com, full:example.com, 1.2.3.4/24, geosite:…"/>
                            <ComboBox x:Name="RuleActionCombo" Grid.Column="2" Height="40" SelectedIndex="0">
                                <ComboBoxItem Content="Через прокси" Tag="proxy"/>
                                <ComboBoxItem Content="Напрямую" Tag="direct"/>
                                <ComboBoxItem Content="Блокировать" Tag="block"/>
                            </ComboBox>
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Добавить правило" Click="AddRule_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Pattern}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="10,6" Content="Удалить" Tag="{Binding Id}" Click="DeleteRule_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="LogsPage" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <ListBox x:Name="LogList"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"/>
                </Border>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Обновления" FontSize="16" FontWeight="SemiBold"/>
                                <CheckBox x:Name="AutoUpdateCheck" Content="Автоматически проверять и скачивать обновления" Margin="0,16,0,14" Checked="AutoUpdateCheck_Changed" Unchecked="AutoUpdateCheck_Changed"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Проверить сейчас" Click="CheckUpdates_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Локальный прокси" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="SOCKS5: 127.0.0.1:10808" Margin="0,14,0,5"/>
                                <TextBlock Text="HTTP: 127.0.0.1:10809"/>
                                <TextBlock Text="TUN будет добавлен отдельно после стабилизации первой версии." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
